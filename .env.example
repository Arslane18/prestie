# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Voyage AI (embeddings) — https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Anthropic (Claude, used by `prestie chat`) — https://console.anthropic.com/
# Optional if you are logged in with `ant auth login`.
ANTHROPIC_API_KEY=

# Prestie addon export, read by `prestie chat` (without --level) and `prestie watch`.
# From WSL, C:\ is /mnt/c/. Written by the game on /reload, logout or exit.
# PRESTIE_SAVEDVARIABLES=/mnt/c/Program Files (x86)/World of Warcraft/_retail_/WTF/Account/<ACCOUNT>/SavedVariables/Prestie.lua

# Blizzard Game Data API (quest details) — https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Optional overrides
# BLIZZARD_REGION=eu  (us, eu, kr, tw: must match the player's realm)
# Changing the embedding model requires re-indexing: `prestie ingest --reset`
# VOYAGE_MODEL=voyage-4-large
# ANTHROPIC_MODEL=claude-opus-5
# PRESTIE_CHROMA_DIR=data/chroma
