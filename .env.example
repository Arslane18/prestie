# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Voyage AI (embeddings) — https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Optional overrides
# Changing the model requires re-indexing: `prestie ingest --reset`
# VOYAGE_MODEL=voyage-4-large
# PRESTIE_CHROMA_DIR=data/chroma
