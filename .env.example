# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Voyage AI (embeddings) — https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Anthropic (Claude, used by `prestie chat`) — https://console.anthropic.com/
# Optional if you are logged in with `ant auth login`.
ANTHROPIC_API_KEY=

# Optional overrides
# Changing the embedding model requires re-indexing: `prestie ingest --reset`
# VOYAGE_MODEL=voyage-4-large
# ANTHROPIC_MODEL=claude-opus-5
# PRESTIE_CHROMA_DIR=data/chroma
